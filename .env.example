# Server-side only. Never expose these variables through NEXT_PUBLIC_*.
OPENROUTER_API_KEY=

# Paid AI is OFF unless AI_MODE=live AND a key is set. Leave unset for demos
# that should only use the deterministic fallback explanation.
AI_MODE=
# Upper bound on Jev-primary + Qwen-secondary calls per hour (per server instance). Default 20.
AI_MAX_CALLS_PER_HOUR=

# Models are pinned in server code:
# U-Bot Simulation only; no official U-Bot API is used.
# Primary: typesafe/jev-1.14
# Secondary: qwen/qwen3.5-9b

# Tokenomist token context (tokenomics only; never a price or FX source).
# Server-side only. Calls are OFF unless TOKENOMIST_MODE=live AND a key is set.
TOKENOMIST_API_KEY=
TOKENOMIST_MODE=
# Upper bound on Tokenomist calls per day (per server instance). Default 24.
TOKENOMIST_MAX_CALLS_PER_DAY=

# CoinGecko Demo API market data for USD prices and 7-day charts.
# Calls are OFF unless COINGECKO_MODE=live AND a Demo API key is set.
COINGECKO_API_KEY=
COINGECKO_MODE=
# demo (default): api.coingecko.com + x-cg-demo-api-key. pro: pro-api.coingecko.com + x-cg-pro-api-key.
COINGECKO_API_TIER=

# ElevenLabs speech-to-text for U-Bot (push-to-talk). Server-side only.
# Calls are OFF unless ELEVENLABS_STT_MODE=live AND a key is set.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODE=
# Upper bound on transcriptions per hour (per server instance). Default 30.
ELEVENLABS_STT_MAX_PER_HOUR=
